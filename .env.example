# Supabase browser configuration (safe to expose; RLS must protect every table).
# Get these from Supabase Dashboard -> Project Settings -> API.
VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY"

# Never put SUPABASE_SERVICE_ROLE_KEY, database passwords, payment secrets, or WhatsApp access tokens
# in any VITE_* variable or frontend file. Those secrets belong only in a trusted server environment.
# Gemini API calls must also be proxied through a server-side function before public launch.
